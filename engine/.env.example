RTDS_URL=wss://ws-live-data.polymarket.com
CLOB_WS_URL=wss://ws-subscriptions-clob.polymarket.com/ws/market
GAMMA_API_URL=https://gamma-api.polymarket.com
DATA_API_URL=https://data-api.polymarket.com
CLOB_API_URL=https://clob.polymarket.com

# Whale alert threshold (USD)
WHALE_THRESHOLD=10000

# Terminal refresh rate (ms, min 100)
TERMINAL_REFRESH_MS=500

# Log level: trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# Node environment (affects log formatting: dev=pino-pretty, prod=JSON)
NODE_ENV=development

# Feed health thresholds (seconds)
ORACLE_STALE_SECS=30
ORDERBOOK_STALE_SECS=15

# Event recording — set to true to write all bus events to ./recordings/
RECORD_EVENTS=false

# Replay mode — set to a .jsonl file path to replay a recording
# REPLAY_FILE=./recordings/2026-05-15T14-30-00.jsonl

# Replay speed multiplier (1.0=realtime, 2.0=2× faster, 0=instant)
REPLAY_SPEED=1.0

# Replay verification — paste the hash printed at end of first replay run to verify determinism
# EXPECTED_STATE_HASH=abcdef0123456789

# Memory pressure warning threshold (MB) — logs a warning when heap exceeds this
MEMORY_WARN_MB=200

# ── Database ────────────────────────────────────────────────────────────────────
# PostgreSQL connection string (required when PERSISTENCE_ENABLED=true)
# DATABASE_URL=postgresql://user:password@localhost:5432/nemo

# Connection pool size
DB_POOL_MIN=2
DB_POOL_MAX=10

# ── Persistence Engine ───────────────────────────────────────────────────────────
# Set to true to write all market data to PostgreSQL (requires DATABASE_URL)
PERSISTENCE_ENABLED=false

# Rows flushed per table per cycle (default: 200)
PERSISTENCE_BATCH_SIZE=200

# Flush interval in ms (min 100, default 500)
PERSISTENCE_FLUSH_MS=500

# Queue backpressure: emit system.warning above WARN, drop events above MAX
PERSISTENCE_QUEUE_WARN=1000
PERSISTENCE_QUEUE_MAX=5000

# ── Event Journal ────────────────────────────────────────────────────────────────
# Set to true to record all bus events to the replay_events table
# Enables DB-based replay with full event history
# Requires PERSISTENCE_ENABLED=true
JOURNAL_ENABLED=false

# ── DB Replay ────────────────────────────────────────────────────────────────────
# Replay events from the database instead of a .jsonl file
# DB_REPLAY_FROM=2026-01-01T00:00:00Z
# DB_REPLAY_TO=2026-01-01T01:00:00Z    (optional — replays to end of journal if omitted)

# ── Signal Engine ────────────────────────────────────────────────────────────────
# Set to true to compute microstructure signals in realtime (emits signal.frame events)
SIGNALS_ENABLED=false

# ── Research Mode ────────────────────────────────────────────────────────────────
# Set RESEARCH_MODE=true with REPLAY_FILE or DB_REPLAY_FROM to run offline analysis.
# Replays all events, computes signals, validates statistically, and exports CSVs.
# Engine exits automatically when replay is complete.
RESEARCH_MODE=false

# Directory to write research output (CSV, JSONL, report JSON)
RESEARCH_OUTPUT_DIR=./research-output

# ── Simulation / Paper Execution ─────────────────────────────────────────────────
# Set SIMULATION_MODE=true with REPLAY_FILE or DB_REPLAY_FROM to backtest a strategy
SIMULATION_MODE=false
SIM_OUTPUT_DIR=./sim-output

# Strategy selection: 'composite' | 'whale' | 'composite,whale' (comma-separated)
SIM_STRATEGY=composite

# Starting capital (USD)
SIM_STARTING_CASH=10000

# Latency model (ms) — total = decision + ws + execution
SIM_DECISION_LATENCY_MS=5
SIM_WS_LATENCY_MS=50
SIM_EXECUTION_LATENCY_MS=10

# Fees (basis points; 20 = 0.20%)
SIM_TAKER_FEE_BPS=20
SIM_MAKER_FEE_BPS=0

# Risk constraints
SIM_MAX_POSITION_USD=1000
SIM_MAX_CONCURRENT_POSITIONS=5
SIM_MAX_CONSECUTIVE_LOSSES=5
SIM_COOLDOWN_AFTER_LOSS_MS=30000

# Optional guards (0 = disabled)
SIM_VOLATILITY_GUARD=0
SIM_LIQUIDITY_GUARD=0

# Strategy thresholds
SIM_MIN_CONFIDENCE=0.60
SIM_MIN_WHALE_SIZE_USD=10000

# ── Validation (Phase 5 — Robustness & Edge Validation Lab) ──────────────────────
# Activate with REPLAY_FILE set. The chosen suite produces JSON + CSV reports.
VALIDATION_MODE=false
VALIDATION_SUITE=full            # sweep | walk-forward | monte-carlo | scenarios | compare | full
VALIDATION_OUTPUT_DIR=./validation-output

# Walk-forward parameters
VALIDATION_WF_WINDOW_MS=1800000      # 30 min total per window
VALIDATION_WF_TRAIN_FRACTION=0.7
VALIDATION_WF_STEP_MS=900000         # advance 15 min between windows

# Monte Carlo parameters (seeded — deterministic per seed)
VALIDATION_MC_RUNS=50
VALIDATION_MC_BASE_SEED=42
VALIDATION_MC_LATENCY_JITTER_MS=10   # gaussian std on event timestamps
VALIDATION_MC_WHALE_SHIFT_MS=2000    # ± uniform shift on whale.alert timestamps
VALIDATION_MC_SPREAD_STD=0.1         # std for N(1, σ²) spread multiplier
VALIDATION_MC_SLIPPAGE_EXTRA_BPS=5   # fixed extra bps on every fill

# ── Live Paper Trading (Phase 6 — Live Drift Observability) ──────────────────────
# Runs the simulation engine against LIVE WebSocket data. No real trades placed.
LIVE_PAPER_ENABLED=false

# Optional baseline JSON (exported from Phase 5 validation) for drift detection.
# Format: { "source": "...", "metrics": { "avgSpread": 0.025, ... } }
# LIVE_BASELINE_FILE=./baselines/2026-05-15-validation.json

# Forensic session recording — mixed JSONL with events + periodic snapshots
LIVE_SESSION_RECORD=true
LIVE_SESSION_OUTPUT_DIR=./live-sessions

# Kill-switch thresholds (0 = disabled). Each is one-way: triggers cannot auto-reset.
LIVE_KILL_SWITCH_VOLATILITY=0.001    # sustained vol > X for 30s
LIVE_KILL_SWITCH_LATENCY_MS=5000     # sustained event-lag p99 > X for 60s
# LIVE_KILL_SWITCH_FILE=./KILL          # poll every 5s; presence = manual stop

# ── Operations Engine (Phase 7 — Long-Run Operations) ────────────────────────────
# Runs the long-duration observability stack on top of live paper trading.
# Edge persistence, drift evolution, reliability, daily reports, dataset curation,
# operational safety. NO real execution, NO ML. Requires LIVE_PAPER_ENABLED=true.
OPS_ENABLED=false
OPS_OUTPUT_DIR=./ops-output
OPS_DATASET_ENABLED=true

# Sampling cadence
OPS_RELIABILITY_SAMPLE_MS=30000      # memory/lag samples every 30s
OPS_EQUITY_SAMPLE_MS=60000           # equity samples every 60s (for Sharpe)

# Strategy degradation policy
OPS_DEGRADE_SHARPE=0.0               # rolling 60-min Sharpe below this = degraded
OPS_AUTOKILL_ON_DEGRADE=false        # if true, degrade → kill-switch

# Reconnect storm guard (routes through existing kill-switch)
OPS_RECONNECT_STORM_COUNT=5
OPS_RECONNECT_STORM_WINDOW_MS=60000

# Memory / feed / disk pressure (0 = disabled where applicable)
OPS_MEMORY_KILL_MB=0                 # sustained heap > X for 60s triggers kill
OPS_DEGRADED_FEED_KILL_MS=60000      # sustained system.degraded > X triggers kill
OPS_DISK_WARN_MB=1024                # warning only when free space below this

# CUSUM structural-break detection (per-metric drift evolution)
OPS_CUSUM_K=2.0                      # allowance (in std-devs)
OPS_CUSUM_H=10.0                     # threshold (accumulated std-devs)

# ── Shadow Execution (Phase 8 — Real-Market Readiness) ───────────────────────────
# SUPERVISED, DRY-RUN ONLY. There is NO code path in the engine that submits
# real orders. Signatures are explicitly labeled 'DRYRUN-…' and cannot be
# mistaken for ECDSA signatures. The wallet is address-only by default.
SHADOW_ENABLED=false
SHADOW_OUTPUT_DIR=./shadow-output

# Wallet adapter — when disabled, the operator address is the zero address.
# When enabled, only the PUBLIC address is read (no private key handling
# exists in this codebase).
SHADOW_WALLET_ENABLED=false
# SHADOW_WALLET_ADDRESS=0x...
# SHADOW_VERIFYING_CONTRACT=0x4bFb41d5B3570DeFd03C39a9A4D8dE6Bd8B8982E  # Polymarket CTF Exchange (Polygon)

# Sandbox guards (hard caps — never auto-release)
SHADOW_MAX_NOTIONAL_USD=100          # any approval > cap auto-rejected
# SHADOW_SINGLE_STRATEGY_LOCK=composite   # if set, only the named strategy may flow
# SHADOW_HALT_FILE=./SHADOW_HALT          # presence = halt + kill-switch

# Approval mode — manual operator approval is the default. Auto-approve is
# only intended for headless integration testing.
SHADOW_AUTO_APPROVE=false

# ── Real Execution Gateway (Phase 9 — Controlled Micro-Live Execution) ───────────
# TRIPLE-FLAG ACTIVATION. All three must flip and per-order operator approval
# is also required (via Phase 8 ApprovalQueue) before anything goes to the
# exchange. Defaults below leave the gateway completely OFF.
EXECUTION_ENABLED=false              # master switch — gateway only constructs if true
EXECUTION_ARMED=false                # required additionally; armed gateway can submit
EXECUTION_DRY_RUN=true               # when true, signs orders but never POSTs to API

# Endpoints
EXECUTION_POLYMARKET_URL=https://clob.polymarket.com
EXECUTION_POLYGON_RPC_URL=https://polygon-rpc.com

# Signer — choose ONE of the following:
#   (a) Hardware-wallet / external signer via JSON-RPC (preferred):
# EXECUTION_SIGNER_RPC_URL=http://localhost:8545
#   (b) Local private key (testnet-class only). Read directly from env by
#       SecureWallet, NEVER logged. Leave empty when using a HW wallet.
# EXECUTION_PRIVATE_KEY=

# Polymarket REST credentials. Required only when EXECUTION_DRY_RUN=false.
# Stored only as SecureSecret in memory, never logged, never journaled.
# EXECUTION_POLYMARKET_API_KEY=
# EXECUTION_POLYMARKET_API_SECRET=
# EXECUTION_POLYMARKET_API_PASSPHRASE=

# Hard caps — very small defaults. Override only after operator review.
EXECUTION_MAX_NOTIONAL_USD=5
EXECUTION_MAX_DAILY_NOTIONAL_USD=50
EXECUTION_MAX_OPEN_POSITIONS=1
EXECUTION_SINGLE_STRATEGY=composite

# RPC health bounds
EXECUTION_RPC_MAX_BLOCK_LAG_SECS=10
EXECUTION_RPC_MAX_GAS_GWEI=500
EXECUTION_RPC_LATENCY_MAX_MS=5000

# Operator console (Unix socket) and emergency halt file
# EXECUTION_CONSOLE_SOCKET=/tmp/nemo-execution.sock
# EXECUTION_HALT_FILE=./EXECUTION_HALT

# Journal output
EXECUTION_JOURNAL_DIR=./execution-journal
